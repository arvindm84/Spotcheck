# Copy to .env and fill in. All three are public, browser-safe values.

# Mapbox public token (starts with pk.) — https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Supabase project URL and anon key (Project Settings → API). Leave blank to run on mock data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
